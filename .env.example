# Copy to .env (git-ignored) and fill in. Used only by the backend; never bundled into the extension.
# This file is committed: it must contain placeholders only, never real credentials.

# anthropic | ollama | openai-compat | mock   (mock = offline plumbing test, NOT real Hinglish)
#   anthropic     Claude via the Anthropic API (paid, per token; needs ANTHROPIC_API_KEY). Recommended: MODEL=claude-haiku-5-5
#   ollama        local model, no API key, page text never leaves this machine (see the Ollama block below)
#   openai-compat Gemini (optional cloud provider), Groq, OpenAI ... needs LLM_API_KEY + BASE_URL
# For Claude set:        PROVIDER=anthropic   MODEL=claude-haiku-5-5   ANTHROPIC_API_KEY=<your key>
# For local Ollama set:   PROVIDER=ollama   MODEL=qwen3:4b
PROVIDER=mock
MODEL=
LLM_API_KEY=
# Provider-specific names are also accepted when LLM_API_KEY is empty (first match wins):
# GEMINI_API_KEY=   ANTHROPIC_API_KEY=   OPENAI_API_KEY=   GROQ_API_KEY=

# openai-compat only: endpoint root of any OpenAI-compatible API, e.g.
#   https://generativelanguage.googleapis.com/v1beta/openai   (Gemini)
#   https://api.groq.com/openai/v1
#   https://api.openai.com/v1
BASE_URL=
# Some OpenAI models require max_completion_tokens instead:
# MAX_TOKENS_PARAM=max_completion_tokens
# Reasoning models (e.g. Gemini 3.x) count hidden reasoning against the token limit and can return
# an empty answer. none | minimal | low | medium | high. Use none for this task where supported.
# REASONING_EFFORT=none

# --- Claude (PROVIDER=anthropic) ------------------------------------------------------------------
# The key is read ONLY from ANTHROPIC_API_KEY (never from LLM_API_KEY, which may hold another provider's key). It stays in
# the backend: it is never sent to the browser extension, never logged, never returned in an error.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is the low-cost model ($0.10 / $0.50 per million input / output tokens). MODEL empty = claude-haiku-5-5.
# Claude 5 models think by default and reject a custom temperature; the backend sends thinking off + low effort and no
# temperature. Override only if you know you need to:
# ANTHROPIC_THINKING=disabled      # disabled | adaptive
# ANTHROPIC_EFFORT=low             # low | medium | high
# One-time paid check (one request, five passages): npm run test:claude-live -- --confirm-live

# --- Ollama (PROVIDER=ollama) -------------------------------------------------------------------
# Needs no API key. LLM_API_KEY / BASE_URL / REASONING_EFFORT are ignored while PROVIDER=ollama, so a
# Gemini key left in this file is never loaded and never sent. MODEL defaults to qwen3:4b when empty.
# Install once:  ollama pull qwen3:4b      Start:  ollama serve   (or the Ollama desktop app)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must be this machine unless you also set OLLAMA_ALLOW_REMOTE=true (page text would then travel to that host).
# OLLAMA_NUM_CTX=8192         # context window; Ollama's own 4096 default can cut the prompt silently
# OLLAMA_KEEP_ALIVE=30m       # keep the model loaded between requests (avoids a slow cold start)
# Ollama defaults when not set: REQUEST_TIMEOUT_MS=40000 (local models are slower; the extension gives up at 45 s)
# and RETRIES=1 (retries a repetition loop that hit the token budget; a timed-out request is never retried because it
# would only queue behind the generation that is still running). Thinking is always switched off.

# Scheduling hints the extension follows (it can only lower them). Ollama defaults: 1 request at a time, 6 blocks / 500 chars
# per request, longer blocks (>600 chars) sent as sentence groups. Unset for other providers = extension defaults.
# FIRST_BATCH_ITEMS=1   (size of the very first request, so the top visible block is not batched with others)
# MAX_CONCURRENCY=1   BATCH_MAX_ITEMS=6   BATCH_MAX_CHARS=500   BATCH_MAX_ITEM_CHARS=600

# Prompt version: hinglish-v2 (default) or hinglish-v1 (kept for A/B comparison)
# PROMPT_VERSION=hinglish-v2

PORT=8787
# TEMPERATURE=0.3         # sampling temperature, 0-2 (default 0.3); invalid values stop startup with an error
# REQUEST_TIMEOUT_MS=30000
# RETRIES=2               # extra attempts after a TRANSIENT failure (brief rate limit, 5xx, timeout); 0 disables.
#                         # Daily-quota errors are never retried.
# RETRY_BASE_MS=300        # backoff = base * 2^attempt (+ small jitter)
# MAX_RETRY_WAIT_MS=10000  # if the provider asks for a longer wait, fail instead of retrying
# RATE_LIMIT_PER_MIN=60
# ACCESS_TOKEN=            # optional shared secret (x-bf-token header) for private deployments
# ALLOWED_ORIGINS=         # comma-separated, only needed for browser (non-extension) callers
